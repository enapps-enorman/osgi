# Set javac settings from JDT prefs
-include: ${build}/eclipse/jdt.bnd, ${build}/osgi.tck.junit-platform.bnd, ${build}/cmpn.bnd

Bundle-Description: Test Bundle for Http Service tests

-conditionalpackage					= org.osgi.test.support.*
-privatepackage						=  \
	${p}.junit.*
Import-Package: ${-signaturetest}, *

-includeresource					= \
	tb1.jar

-signaturetest                      = org.osgi.service.http

-buildpath = \
    org.osgi.test.support;version=project, \
    org.osgi.framework;maven-scope=provided;version=1.8, \
    org.osgi.util.tracker;maven-scope=provided;version=1.5, \
    org.osgi.service.http;version=latest, \
	org.osgi.impl.bundle.servlet;version=2.1

-runbundles = \
	slf4j.api; version=latest, \
	slf4j.simple; version=latest, \
	org.objectweb.asm.tree.analysis; version=latest, \
	org.objectweb.asm.commons; version=latest, \
	org.objectweb.asm.tree; version=latest, \
	org.objectweb.asm.util; version=latest, \
	org.objectweb.asm; version=latest, \
	org.apache.aries.spifly.dynamic.bundle; version=latest, \
	org.osgi.impl.service.log; version=latest, \
	org.osgi.impl.service.http; version=latest
# These two are needed for jetty 5.2.2 but not for 5.2.3-SNAPSHOT
#	org.apache.commons.commons-fileupload; version=latest, \
#	org.apache.commons.commons-io; version=latest, \

-runproperties = ${runproperties}, \
	org.osgi.service.http.hostname=127.0.0.1, \
	org.osgi.service.http.port=8080
